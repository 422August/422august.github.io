---
// src/components/CaptionImage.astro
import { Image } from "astro:assets";

interface Props {
    name: string; // e.g., "photo.jpg"
    alt: string;
    width?: number;
    height?: number;
}

const { name, alt, width = 800, height = 400 } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/content/**/*.{jpg,jpeg,png,webp,gif}",
);

// 2. Filter the map keys to find the one matching your filename
const imagePath = Object.keys(allImages).find((key) => key.endsWith(`/${name}`));

if (!imagePath) {
    throw new Error(`[CaptionImage] Image "${name}" not found in your content folder.`);
}
---

<figure class="image-container">
    <Image src={allImages[imagePath]()} alt={alt} width={width} height={height} />
    <figcaption class="image-caption">
        {alt}
    </figcaption>
</figure>

<style>
    .image-container {
        margin: 2rem auto;
        text-align: center;
    }
    .image-container img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }
    .image-caption {
        margin-top: 0.5rem;
        font-size: 0.875rem;
        color: #666;
        font-style: italic;
    }
</style>
