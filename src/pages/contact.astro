---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";

// 社群與聯繫管道設定
const socialLinks = [
  {
    name: "GitHub",
    label: "422august",
    href: "https://github.com/422august",
    icon: "github",
  },
  {
    name: "Twitter / X",
    label: CONTACT.socialHandle || "@422august",
    href: CONTACT.socialUrl || "https://x.com/422august",
    icon: "twitter",
  },
  {
    name: "RSS Feed",
    label: "訂閱 RSS",
    href: "/rss.xml",
    icon: "rss",
  },
];
---

<BaseLayout
  title={`聯絡方式 — ${SITE.name}`}
  description={`與 ${SITE.name} 建立聯繫，歡迎透過 Email、GitHub 或社群平台交流。`}
  canonical="/contact"
>
  <div class="mx-auto max-w-2xl px-5 py-12">
    <Breadcrumbs items={[{ label: "首頁", to: "/" }, { label: "聯絡方式" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Contact</div>
      <h1 class="mt-2 font-serif text-4xl font-semibold sm:text-5xl">聯絡方式</h1>
      <p class="mt-4 max-w-xl leading-relaxed text-muted-foreground">
        無論是專案合作、技術討論，或者對文章內容有任何想法，都歡迎透過以下管道與我聯繫。
      </p>
    </header>

    <main class="mt-10">
      <ul class="divide-y divide-border border-y border-border">
        {
          socialLinks.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={item.href.startsWith("http") ? "noreferrer" : undefined}
                class="group flex items-center justify-between py-4 transition-colors hover:text-primary"
              >
                <div class="flex items-center gap-3">
                  <Icon
                    name={item.icon}
                    class="h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors"
                  />
                  <span class="font-medium text-foreground group-hover:text-primary transition-colors">
                    {item.name}
                  </span>
                </div>
                <span class="text-sm text-muted-foreground group-hover:text-primary transition-colors">
                  {item.label} &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</BaseLayout>