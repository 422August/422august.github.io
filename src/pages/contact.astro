---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";

// 可以在這個陣列直接新增、修改或刪除社群連結
const socialLinks = [
  {
    name: "Twitter / X",
    label: CONTACT.socialHandle || "@422august",
    href: CONTACT.socialUrl || "https://x.com",
    icon: "twitter",
  },
  {
    name: "GitHub",
    label: "422august",
    href: "https://github.com/422august",
    icon: "github",
  },
  {
    name: "RSS Feed",
    label: "Subscribe to RSS",
    href: "/rss.xml",
    icon: "rss",
  },
];
---

<BaseLayout
  title={`Contact - ${SITE.name}`}
  description={`Connect with ${SITE.name}.`}
  canonical="/contact"
>
  <div class="mx-auto max-w-2xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Contact" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">聯絡</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold">在這裡與我聯繫</h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        如果你對我的文章、專案或任何技術相關的話題有興趣，歡迎透過以下方式與我聯繫。
      </p>
    </header>

    <main class="mt-10">
      <ul class="divide-y divide-border border-y border-border">
        {
          socialLinks.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={item.href.startsWith("http") ? "noreferrer" : undefined}
                class="group flex items-center justify-between py-4 transition-colors hover:text-primary"
              >
                <div class="flex items-center gap-3">
                  <Icon
                    name={item.icon}
                    class="h-4 w-4 text-muted-foreground group-hover:text-primary"
                  />
                  <span class="font-medium text-foreground group-hover:text-primary">
                    {item.name}
                  </span>
                </div>
                <span class="text-sm text-muted-foreground group-hover:text-primary">
                  {item.label} &rarr;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</BaseLayout>
