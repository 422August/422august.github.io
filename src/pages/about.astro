---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, authors } from "../lib/blog-data.js";
---

<BaseLayout
  title={`About - ${SITE.name}`}
  description={`About ${SITE.name}: an independent magazine on writing, design, and the slow web.`}
  canonical="/about"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "About" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">About</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">A blog of August.</h1>
    </header>

    <div class="prose-article mt-10">
      <p>
        August's Blog is a personal blog by August0422, a high school student and aspiring
        developer. The blog covers topics related to AI, technology, and the future, with a focus on
        sharing insights, experiences, and knowledge in these areas.
      </p>
      <h2 id="who-I-am">Who I am</h2>
      <p>
        A high school student with a passion for technology and AI. I enjoy coding in Python and
        JavaScript, building side projects, and exploring the latest advancements in AI and NLP. My
        goal is to share my learning journey and insights through this blog.
      </p>

      <h2 id="experience">Experience</h2>
      <p>
        <ul>
          <li>President of Software Development Club</li>
          <li>Top 1 in Mandatory Computer Science Curriculum (School-wide)</li>
          <li>APCS 4 + 2</li>
        </ul>
      </p>
    </div>

    <section class="mt-12 border-t border-border pt-10">
      <h2 class="font-serif text-2xl font-semibold">Contributors</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          authors.map((author) => (
            <a href={`/authors/${author.slug}`} class="group flex items-start gap-3">
              <img
                src={author.avatar}
                alt=""
                width="48"
                height="48"
                class="h-12 w-12 rounded-full"
              />
              <div>
                <div class="font-serif text-base font-semibold group-hover:text-primary">
                  {author.name}
                </div>
                <div class="mt-1 text-sm text-muted-foreground">{author.bio}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
