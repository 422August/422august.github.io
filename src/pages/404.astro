---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found - Quiet Pages" description="The page could not be found.">
  <div class="mx-auto max-w-2xl px-5 py-32 text-center">
    <div class="font-serif text-7xl font-semibold">404</div>
    <h1 class="mt-4 font-serif text-2xl font-semibold">在時代洪流中消失。</h1>
    <p class="mt-3 text-muted-foreground">該頁面不存在。</p>
    <p class="mt-3 text-muted-foreground">您查找的頁面可能已被移動或刪除。</p>
    <div class="mt-6 flex justify-center gap-3">
      <a
        href="/"
        class="rounded-md bg-foreground px-4 py-2 text-sm font-medium text-background hover:opacity-90"
      >
        回到首頁
      </a>
      <a href="/blog" class="rounded-md border border-border px-4 py-2 text-sm hover:bg-muted">
        查看文章
      </a>
    </div>
  </div>
</BaseLayout>
